<?xml version="1.0"?>

<robot xmlns:xacro="http://ros.org/wiki/xacro">

    <xacro:include filename="$(find jo_description)/urdf/inertial_macros.xacro" />

    <!-- Velodyne VLP-16 (Puck Lite). Frame from CAD triad "TERNA - velodyne":
         on the sensor axis, 37.7 mm above its base (optical centre), axes aligned
         with base_link. CAD position: (0.289, 0, 1.0777). -->
    <xacro:property name="lidar_cad_x" value="0.289" />
    <xacro:property name="lidar_cad_y" value="0.0" />
    <xacro:property name="lidar_cad_z" value="1.0777" />
    <xacro:property name="lidar_mass" value="0.125" />
    <xacro:property name="lidar_radius" value="0.0517" />
    <xacro:property name="lidar_height" value="0.0726" />
    <xacro:property name="lidar_base_to_origin" value="0.0377" />  <!-- sensor base to optical centre -->

    <xacro:macro name="lidar_sensor" params="namespace">
        <joint name="base2lidar" type="fixed">
            <parent link="base_link"/>
            <child link="velodyne"/>
            <origin xyz="${lidar_cad_x - cad2base_x} ${lidar_cad_y} ${lidar_cad_z - cad2base_z}" rpy="0 0 0"/>
        </joint>
        <link name="velodyne">
            <visual>
                <geometry>
                    <mesh filename="package://jo_description/meshes/vlp16.stl"/>
                </geometry>
                <material name="aluminum"/>
            </visual>
            <collision>
                <origin xyz="0 0 ${lidar_height/2 - lidar_base_to_origin}" rpy="0 0 0"/>
                <geometry>
                    <cylinder radius="${lidar_radius}" length="${lidar_height}"/>
                </geometry>
            </collision>
            <xacro:inertial_cylinder mass="${lidar_mass}" radius="${lidar_radius}" length="${lidar_height}">
                <origin xyz="0 0 ${lidar_height/2 - lidar_base_to_origin}" rpy="0 0 0"/>
            </xacro:inertial_cylinder>
        </link>
        <gazebo reference="velodyne">
            <sensor name="RGLsensor" type="custom">
                <plugin filename="RGLServerPluginInstance" name="rgl::RGLServerPluginInstance">
                    <range>
                    <min>0.1</min>
                    <max>100</max>
                    </range>
                    <update_rate>10</update_rate>
                    <update_on_paused_sim>false</update_on_paused_sim>
                    <topic>${namespace}/velodyne_points</topic>
                    <frame>velodyne</frame>
                    <pattern_preset>Puck</pattern_preset>
                </plugin>
            </sensor>
        </gazebo>


        <!-- Lidar support: two 40x40 profiles on the rack + 80x80 block and 45deg brackets.
             Frame on the mounting surface under the lidar. -->
        <link name="velodyne_holder">
            <xacro:cad_mesh file="lidar_mount.stl"    material="dark"
                            x="${lidar_cad_x}" y="${lidar_cad_y}" z="${lidar_cad_z - lidar_base_to_origin}"/>
            <xacro:cad_mesh file="lidar_profiles.stl" material="aluminum"
                            x="${lidar_cad_x}" y="${lidar_cad_y}" z="${lidar_cad_z - lidar_base_to_origin}"/>
            <!-- 40x40 profiles: CAD x = -0.205 .. 0.370, y = +-0.0575, z = 0.920 .. 0.960 -->
            <collision>
                <origin xyz="${(-0.205 + 0.370)/2 - lidar_cad_x} 0 ${(0.920 + 0.960)/2 - (lidar_cad_z - lidar_base_to_origin)}"/>
                <geometry>
                    <box size="${0.370 + 0.205} 0.115 0.040"/>
                </geometry>
            </collision>
            <!-- 80x80 block: CAD x = 0.249 .. 0.329, y = +-0.0625, z = 0.960 .. 1.040 -->
            <collision>
                <origin xyz="${(0.249 + 0.329)/2 - lidar_cad_x} 0 ${(0.960 + 1.040)/2 - (lidar_cad_z - lidar_base_to_origin)}"/>
                <geometry>
                    <box size="0.080 0.125 0.080"/>
                </geometry>
            </collision>
        </link>

        <joint name="lidar2holder" type="fixed">
            <parent link="velodyne"/>
            <child link="velodyne_holder"/>
            <origin xyz="0 0 ${-lidar_base_to_origin}" rpy="0 0 0"/>
        </joint>

    </xacro:macro>

    <xacro:lidar_sensor namespace=""/>

</robot>
