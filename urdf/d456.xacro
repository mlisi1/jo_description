<?xml version="1.0"?>

<robot xmlns:xacro="http://ros.org/wiki/xacro">

    <xacro:include filename="$(find jo_description)/urdf/inertial_macros.xacro" />

    <!-- Intel RealSense D456. The link follows the realsense2_description
         convention for camera_link: on the left IR imager (depth origin),
         4.7 mm behind the front cover, X out of the lens, Z up.
         Positions from the CAD triads "TERNA - d456_front_link" / "d456_back_link". -->
    <xacro:property name="camera_mass" value="0.125" />
    <!-- body, w.r.t. the camera link -->
    <xacro:property name="camera_size_x" value="0.0264" />
    <xacro:property name="camera_size_y" value="0.1245" />
    <xacro:property name="camera_size_z" value="0.0292" />
    <xacro:property name="camera_body_x" value="-0.0084" />
    <xacro:property name="camera_body_y" value="-0.0475" />  <!-- camera centre is 47.5 mm right of the left imager -->

    <!-- x y z: link position in the CAD frame -->
    <xacro:macro name="d456_camera" params="prefix x y z yaw">
        <joint name="base2${prefix}_camera" type="fixed">
            <parent link="base_link"/>
            <child link="${prefix}_camera_link"/>
            <origin xyz="${x - cad2base_x} ${y} ${z - cad2base_z}" rpy="0 0 ${yaw}"/>
        </joint>
        <link name="${prefix}_camera_link">
            <visual>
                <geometry>
                    <mesh filename="package://jo_description/meshes/d456.stl"/>
                </geometry>
                <material name="gray"/>
            </visual>

            <collision>
                <origin xyz="${camera_body_x} ${camera_body_y} 0" rpy="0 0 0"/>
                <geometry>
                    <box size="${camera_size_x} ${camera_size_y} ${camera_size_z}"/>
                </geometry>
            </collision>

            <xacro:inertial_box mass="${camera_mass}" x="${camera_size_x}" y="${camera_size_y}" z="${camera_size_z}">
                    <origin xyz="${camera_body_x} ${camera_body_y} 0" rpy="0 0 0"/>
            </xacro:inertial_box>

        </link>
        <gazebo reference="${prefix}_camera_link">
            <sensor name="${prefix}_d456" type="rgbd_camera">
                <gz_frame_id>${prefix}_camera_link</gz_frame_id>
                <always_on>true</always_on>
                <update_rate>30</update_rate>
                <visualize>true</visualize>

                <!-- RGB camera -->
                <camera name="color">
                <horizontal_fov>1.50</horizontal_fov>  <!-- ≈86 deg -->
                <image>
                    <width>640</width>
                    <height>480</height>
                    <format>R8G8B8</format>
                </image>
                <clip>
                    <near>0.1</near>
                    <far>20</far>
                </clip>
                </camera>

                <!-- Depth -->
                <depth_camera>
                <clip>
                    <near>0.35</near>
                    <far>8.0</far>
                </clip>

                </depth_camera>

                <topic>${prefix}_camera</topic>
            </sensor>
        </gazebo>
    </xacro:macro>

    <xacro:d456_camera prefix="front" x="0.4183" y="0.0475"  z="0.7360" yaw="0"/>
    <xacro:d456_camera prefix="back"  x="-0.2283" y="-0.0475" z="0.7360" yaw="${pi}"/>

</robot>
